# AlignForge Environment Configuration

# Application
APP_NAME=AlignForge
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Postgres + pgvector in docker; SQLite for zero-setup local dev)
DATABASE_URL=sqlite+aiosqlite:///./alignforge.db
# DATABASE_URL=postgresql+asyncpg://alignforge:alignforge_secret@localhost:5432/alignforge_db
AUTO_CREATE_TABLES=true

# Celery & Redis Task Queue
USE_CELERY=false
# REDIS_URL=redis://localhost:6379/0

# Model Configuration (Qwen2.5-0.5B-Instruct lightweight out-of-the-box model)
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Generation & Judge Backends
GENERATOR_BACKEND=none
# GENERATOR_BACKEND=local
# GENERATOR_BACKEND=litellm
# GENERATOR_LITELLM_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=heuristic
# JUDGE_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Active Learning Parameters
DEDUPE_THRESHOLD=0.95
PRIORITY_ENTROPY_WEIGHT=0.5
PRIORITY_DIVERGENCE_WEIGHT=0.5
HUMAN_REVIEW_THRESHOLD=0.35

# Training Artifacts Directory
TRAINING_OUTPUT_DIR=./artifacts/training
